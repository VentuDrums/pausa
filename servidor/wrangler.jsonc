{
  // Intermediario de Pausa: publica con `npx wrangler deploy` desde esta carpeta.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pausa-ia",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "ai": { "binding": "AI" },
  // Privacidad: sin registros de peticiones ni de consola (Workers Logs) y sin envío de registros a terceros.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "logpush": false
}
